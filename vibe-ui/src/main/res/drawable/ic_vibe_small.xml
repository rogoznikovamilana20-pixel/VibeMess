<?xml version="1.0" encoding="utf-8"?>
<!-- Vibe Logo - Small Version -->
<!-- Optimized for 16-48px sizes -->
<!-- Thicker lines, simplified center node, no glow -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:translateX="12"
        android:translateY="12">

        <!-- Left arm - thicker for small size -->
        <path
            android:pathData="M-8,-8 L0,8"
            android:strokeWidth="2.5"
            android:strokeColor="#8B5CF6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Right arm -->
        <path
            android:pathData="M0,8 L8,-8"
            android:strokeWidth="2.5"
            android:strokeColor="#7C3AED"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

    </group>

</vector>
