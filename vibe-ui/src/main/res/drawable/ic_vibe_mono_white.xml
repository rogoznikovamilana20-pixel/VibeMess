<?xml version="1.0" encoding="utf-8"?>
<!-- Vibe Logo - White Monochrome Version -->
<!-- For use on dark backgrounds, documents, watermarks -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="54"
        android:translateY="54">

        <!-- Left arm -->
        <path
            android:pathData="M-20,-20 L0,20"
            android:strokeWidth="5"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Right arm -->
        <path
            android:pathData="M0,20 L20,-20"
            android:strokeWidth="5"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Center node -->
        <path
            android:pathData="M0,20 L0,20"
            android:strokeWidth="2.5"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />

    </group>

</vector>
