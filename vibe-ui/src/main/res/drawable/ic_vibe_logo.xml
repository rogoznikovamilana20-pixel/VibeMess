<?xml version="1.0" encoding="utf-8"?>
<!-- Vibe App Icon - Primary Dark Version -->
<!-- Глубокий тёмный фиолетово-чёрный фон + фиолетовый знак V -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background - Deep dark purple-black gradient -->
    <path
        android:pathData="M0,0h108v108H0z"
        android:fillColor="#0C081A" />

    <!-- Soft gradient overlay (center lighter) -->
    <path
        android:pathData="M54,20 L54,20"
        android:strokeColor="#17102D"
        android:strokeWidth="0"
        android:fillAlpha="0.3" />

    <!-- Glow effect - subtle purple glow around the V -->
    <path
        android:pathData="M54,38 C44,38 36,46 36,56 L36,56 L36,56 C36,66 44,74 54,74 C64,74 72,66 72,56 L72,56 C72,46 64,38 54,38z"
        android:fillColor="#8B5CF6"
        android:fillAlpha="0.08" />

    <!-- V Logo - Left diagonal stroke -->
    <path
        android:pathData="M32,28 L32,28 L54,72 L54,72"
        android:strokeColor="@android:color/transparent"
        android:strokeWidth="0" />

    <!-- V Logo - Main V shape with gradient -->
    <group
        android:translateX="54"
        android:translateY="50"
        android:rotation="0">

        <!-- Left arm of V -->
        <path
            android:pathData="M-22,-22 L0,22"
            android:strokeWidth="5.5"
            android:strokeColor="#A78BFA"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Right arm of V -->
        <path
            android:pathData="M0,22 L22,-22"
            android:strokeWidth="5.5"
            android:strokeColor="#7C3AED"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Central energy node -->
        <path
            android:pathData="M0,22 L0,22"
            android:strokeWidth="3"
            android:strokeColor="#8B5CF6"
            android:strokeLineCap="round" />

        <!-- Energy pulse from center -->
        <path
            android:pathData="M0,18 L0,26"
            android:strokeWidth="2"
            android:strokeColor="#A78BFA"
            android:strokeAlpha="0.6"
            android:strokeLineCap="round" />

    </group>

</vector>
