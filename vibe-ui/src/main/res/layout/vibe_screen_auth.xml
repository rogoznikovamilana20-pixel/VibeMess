<?xml version="1.0" encoding="utf-8"?>
<!-- Auth Screen - Per TЗ §5 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0C0B1A"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vibe_icon_back"
            android:contentDescription="Назад"
            android:padding="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Вход / Регистрация"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- V Logo -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_vibe_logo"
        android:contentDescription="Vibe"
        android:layout_marginBottom="16dp" />

    <!-- Phone Input -->
    <EditText
        android:id="@+id/input_phone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/vibe_bg_glass"
        android:hint="Номер телефона"
        android:textColorHint="#7B7590"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="phone"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <!-- OTP Container (hidden initially) -->
    <LinearLayout
        android:id="@+id/otp_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Введите код из SMS"
            android:textColor="#B4B0C8"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <EditText
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:background="@drawable/vibe_bg_glass"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:layout_marginEnd="8dp" />

            <EditText
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:background="@drawable/vibe_bg_glass"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:layout_marginEnd="8dp" />

            <EditText
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:background="@drawable/vibe_bg_glass"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:layout_marginEnd="8dp" />

            <EditText
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:background="@drawable/vibe_bg_glass"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Submit Button -->
    <LinearLayout
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/vibe_bg_premium_button"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Продолжить"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress Bar (hidden initially) -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="#8B5CF6"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- Social Login -->
    <LinearLayout
        android:id="@+id/social_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#2D2952" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="или войти через"
                android:textColor="#7B7590"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#2D2952" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/vibe_bg_glass"
                android:padding="12dp"
                android:src="@drawable/vibe_icon_menu"
                android:contentDescription="Google"
                android:tint="#FFFFFF" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/vibe_bg_glass"
                android:padding="12dp"
                android:src="@drawable/vibe_icon_menu"
                android:contentDescription="VK"
                android:tint="#FFFFFF" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/vibe_bg_glass"
                android:padding="12dp"
                android:src="@drawable/vibe_icon_menu"
                android:contentDescription="Telegram"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Terms -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Продолжая, вы соглашаетесь с Условиями и Политикой конфиденциальности"
        android:textColor="#7B7590"
        android:textSize="12sp"
        android:textAlignment="center" />
</LinearLayout>
