<?xml version="1.0" encoding="utf-8"?>
<!-- Server Settings Screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0C0B1A"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vibe_icon_back"
            android:contentDescription="Назад"
            android:padding="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Настройки сервера"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Server URL -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="АДРЕС СЕРВЕРА"
        android:textColor="#7B7590"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/input_server_url"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/vibe_bg_glass"
        android:hint="http://10.0.2.2:8766"
        android:textColorHint="#7B7590"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="textUri"
        android:singleLine="true"
        android:layout_marginBottom="24dp" />

    <!-- Status -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="СТАТУС"
        android:textColor="#7B7590"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/text_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Не подключено"
        android:textColor="#F87171"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <!-- User Info -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ДАННЫЕ ПОЛЬЗОВАТЕЛЯ"
        android:textColor="#7B7590"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/text_user_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User ID: ---"
        android:textColor="#B4B0C8"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/text_vibe_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vibe ID: ---"
        android:textColor="#8B5CF6"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <!-- Buttons -->
    <Button
        android:id="@+id/btn_test"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/vibe_bg_glass"
        android:text="Проверить соединение"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/vibe_bg_premium_button"
        android:text="Сохранить"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
