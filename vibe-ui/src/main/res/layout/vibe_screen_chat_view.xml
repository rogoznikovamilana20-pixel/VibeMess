<?xml version="1.0" encoding="utf-8"?>
<!-- Chat Screen - Per TЗ §8 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0C0B1A">

    <!-- Chat Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:background="#0F0D1A">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vibe_icon_back"
            android:contentDescription="Назад"
            android:padding="12dp" />

        <!-- Avatar -->
        <ImageView
            android:id="@+id/header_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/vibe_bg_avatar"
            android:layout_marginEnd="12dp" />

        <!-- Name and status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/header_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="в сети"
                android:textColor="#4ADE80"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Audio call -->
        <ImageButton
            android:id="@+id/btn_audio_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vibe_icon_chats"
            android:contentDescription="Аудиозвонок"
            android:padding="8dp"
            android:layout_marginEnd="4dp" />

        <!-- Video call -->
        <ImageButton
            android:id="@+id/btn_video_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vibe_icon_chats"
            android:contentDescription="Видеозвонок"
            android:padding="8dp"
            android:layout_marginEnd="4dp" />

        <!-- Search -->
        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vibe_icon_search"
            android:contentDescription="Поиск"
            android:padding="8dp"
            android:layout_marginEnd="4dp" />

        <!-- Menu -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vibe_icon_menu"
            android:contentDescription="Меню"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp"
        android:background="#0C0B1A" />

    <!-- Aurion quick actions (hidden by default) -->
    <LinearLayout
        android:id="@+id/aurion_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#161429"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 Aurion:"
            android:textColor="#8B5CF6"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/aurion_action_reply"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/vibe_bg_glass"
            android:text="Ответить"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/aurion_action_translate"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/vibe_bg_glass"
            android:text="Перевести"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/aurion_action_summarize"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/vibe_bg_glass"
            android:text="Суммировать"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#0F0D1A">

        <!-- Attach button -->
        <ImageButton
            android:id="@+id/btn_attach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/vibe_icon_menu"
            android:contentDescription="Вложения"
            android:padding="8dp" />

        <!-- Message input -->
        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/vibe_bg_glass"
            android:hint="Сообщение..."
            android:textColorHint="#7B7590"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:singleLine="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="text"
            android:imeOptions="actionSend" />

        <!-- Aurion button -->
        <ImageButton
            android:id="@+id/btn_aurion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/vibe_bg_avatar"
            android:src="@drawable/vibe_icon_aurion"
            android:contentDescription="Aurion"
            android:padding="8dp"
            android:layout_marginEnd="4dp" />

        <!-- Send / Voice button -->
        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/vibe_bg_premium_button"
            android:src="@drawable/vibe_icon_search"
            android:contentDescription="Отправить"
            android:padding="10dp" />
    </LinearLayout>
</LinearLayout>
