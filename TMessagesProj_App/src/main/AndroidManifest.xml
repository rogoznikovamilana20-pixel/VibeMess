<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <application 
        android:name="org.telegram.messenger.ApplicationLoaderImpl" 
        tools:replace="name,android:usesCleartextTraffic,android:allowBackup"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        tools:targetApi="24"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- Vibe Splash Screen - Main Launcher -->
        <activity
            android:name="com.vibe.ui.screens.SplashActivity"
            android:theme="@style/Theme.Vibe"
            android:exported="true"
            android:label="Vibe"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Vibe Main Activity -->
        <activity
            android:name="com.vibe.ui.VibeActivity"
            android:theme="@style/Theme.Vibe"
            android:exported="false"
            android:label="Vibe"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- Offline/Error State -->
        <activity
            android:name="com.vibe.ui.screens.OfflineErrorActivity"
            android:theme="@style/Theme.Vibe"
            android:exported="false"
            android:label="Error"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.vibe.ui.security.VerificationActivity"
            android:theme="@style/Theme.Vibe"
            android:exported="false"
            android:label="Verification"
            android:windowSoftInputMode="adjustResize"
            tools:node="remove"
            tools:ignore="MissingClass" />

            <!-- Vibe Incoming Call Activity -->
        <activity
            android:name="com.vibe.ui.call.IncomingCallActivity"
            android:exported="false"
            android:theme="@style/Theme.Vibe"
            android:label="Incoming Call"
            android:windowSoftInputMode="adjustResize" />

            <!-- Vibe Download Foreground Service -->
        <service
            android:name="com.vibe.ui.service.VibeDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

            <!-- Vibe Call Signaling Foreground Service -->
        <service
            android:name="com.vibe.ui.call.VibeCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Remove Telegram launcher activities & aliases - keep only Vibe SplashActivity -->
        <activity
            android:name="org.telegram.ui.LaunchActivity"
            android:exported="false"
            tools:node="remove"
            tools:ignore="Instantiatable" />

        <activity-alias
            android:name="org.telegram.messenger.DefaultIcon"
            android:exported="false"
            tools:node="remove" />
        <activity-alias
            android:name="org.telegram.messenger.VintageIcon"
            android:exported="false"
            tools:node="remove" />
        <activity-alias
            android:name="org.telegram.messenger.AquaIcon"
            android:exported="false"
            tools:node="remove" />
        <activity-alias
            android:name="org.telegram.messenger.PremiumIcon"
            android:exported="false"
            tools:node="remove" />
        <activity-alias
            android:name="org.telegram.messenger.TurboIcon"
            android:exported="false"
            tools:node="remove" />
        <activity-alias
            android:name="org.telegram.messenger.NoxIcon"
            android:exported="false"
            tools:node="remove" />
        <activity-alias
            android:name="org.telegram.ui.CallsActivity"
            android:exported="false"
            tools:node="remove" />

        <!-- Telegram Activities (non-launcher) -->
        <service
            android:name="org.telegram.messenger.GoogleVoiceClientService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            tools:ignore="ExportedService"
            tools:node="remove" />
        <activity
            android:name="org.telegram.messenger.GoogleVoiceClientActivity"
            android:exported="true"
            tools:node="remove">
            <intent-filter>
                <action android:name="com.google.android.voicesearch.SEND_MESSAGE_TO_CONTACTS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
